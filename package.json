{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "cross-env SKIP_ENV_VALIDATION=true next build",
    "build:prod": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed:ipa": "node prisma/seed-ipa.js",
    "backup:db": "bash scripts/backup-database.sh",
    "restore:db": "bash scripts/restore-database.sh",
    "cache:clear": "node -e \"require('./src/lib/cache').cache.clearAll()\"",
    "cache:stats": "node -e \"console.log(require('./src/lib/cache').cache.getStats())\"",
    "migrate:multi-role": "ts-node --compiler-options {\\\"module\\\":\\\"CommonJS\\\"} prisma/migrate-users-to-multi-role.ts",
