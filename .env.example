# Database
# Connection pool configuration for production stability
# connection_limit: Max number of connections (default: 10)
# pool_timeout: Timeout in seconds for acquiring connection (default: 20)
DATABASE_URL="postgresql://user:password@localhost:5432/elearning?connection_limit=10&pool_timeout=20"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="noreply@bnifinance.co.id"
SMTP_PASS="your-smtp-password"
ADMIN_EMAIL="admin@bnifinance.co.id"

# Cron Jobs Security
# Generate with: openssl rand -base64 32
CRON_SECRET="your-cron-secret-here"

# Optional: File Upload
MAX_FILE_SIZE="10485760"
